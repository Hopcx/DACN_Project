# T20: mẫu cấu hình cho deploy/docker-compose.yml. Chép thành deploy/.env rồi điền giá trị thật.
#   cp .env.example .env && chmod 600 .env
# KHÔNG commit .env. Sinh khóa ngẫu nhiên: openssl rand -base64 48
# Giá trị có ký tự đặc biệt ($, khoảng trắng, #) thì đặt trong nháy đơn: KEY='giá trị'

# ---- Tên miền / HTTPS (Caddy tự lấy chứng chỉ Let's Encrypt cho SITE_HOST) ----
SITE_HOST=dacn.example.com
PUBLIC_ORIGIN=https://dacn.example.com
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
HSTS_MAX_AGE=31536000

# ---- SQL Server (container) ----
# Bản Express miễn phí (giới hạn dung lượng mỗi DB — 2025 Express được công bố nâng lên 50 GB; kiểm lại điều khoản bản đang dùng).
# Mật khẩu sa: ≥ 8 ký tự, có chữ hoa, chữ thường, số, ký hiệu.
MSSQL_PID=Express
# Ghim image SQL bằng digest deploy.sh in ra sau DEPLOY_OK (vd. mcr.microsoft.com/mssql/server@sha256:...); để trống = 2025-latest
MSSQL_IMAGE=
MSSQL_SA_PASSWORD=
MSSQL_MEMORY_LIMIT_MB=2048
DB_NAME=ProjectDACN
# Login riêng của API (restore-db.sh tạo, chỉ có quyền đọc/ghi dữ liệu)
DB_APP_USER=dacn_app
# Chỉ dùng chữ, số và + / = _ @ # % . ! - (nằm trong chuỗi kết nối)
DB_APP_PASSWORD=

# ---- Khóa bí mật (mỗi khóa ≥ 32 byte, sinh mới, không dùng lại khóa trong repo) ----
JWT_SECRET_KEY=
MEDIA_SIGNING_KEY=

# ---- SMTP gửi email xác minh (vd. Gmail App Password, Brevo, Mailgun) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# ---- Khác ----
# Thư mục backup trên máy chủ (backup.sh ghi vào, restore-db.sh đọc từ đây)
BACKUP_DIR=./backups
BACKUP_KEEP=7
# Đường dẫn repo FE tính từ deploy/
FE_PATH=../../DACN_FE
DOCKER_SUBNET=172.28.0.0/16
IMAGE_TAG=latest
